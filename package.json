{
  "name": "@exercism/javascript-browser-test-runner",
  "version": "3.0.0",
  "description": "Exercism JavaScript Track test runner that runs in the browser",
  "sideEffects": false,
  "source": "src/index.ts",
  "types": "./output/index.d.ts",
  "exports": {
    ".": {
      "types": "./output/index.d.ts",
      "import": "./output/imported.mjs",
      "require": "./output/required.cjs",
      "default": "./output/fallback.js"
    }
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "pnpm rimraf output && pnpm node build.mjs && tsc",
    "build:dev": "pnpm rimraf output && cross-env MINIFY=false pnpm node build.mjs && tsc",
    "sample": "pnpm build:dev && pnpm dlx serve sample"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exercism/js-test-runner-clientside.git"
  },
  "author": "Derk-Jan Karrenbeld <derk-jan+git@karrenbeld.info>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/exercism/js-test-runner-clientside/issues"
  },
  "homepage": "https://github.com/exercism/js-test-runner-clientside#readme",
  "devDependencies": {
    "baseline-browser-mapping": "^2.9.17",
    "browserslist": "^4.28.1",
    "browserslist-to-esbuild": "^2.1.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.3",
    "esbuild-plugins-node-modules-polyfill": "^1.8.1",
    "expect": "^30.2.0",
    "jest-mock": "^30.2.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "src/*",
    "dist/*",
    "output/*",
    "package.json",
    "tsconfig.json",
    "yarn.lock"
  ],
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "dependencies": {
    "htmlparser2": "^10.1.0"
  }
}
